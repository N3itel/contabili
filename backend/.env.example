# Copia este archivo a .env y ajusta los valores.
NODE_ENV=development
PORT=3000
# Coincide con infra/docker-compose.yml
DATABASE_URL=postgres://contabili:contabili@localhost:5432/contabili
# Balanceadores delante de la app (para que el tope por IP vea la IP real).
TRUST_PROXY_HOPS=0

# Firma los tokens y los códigos. En producción: 32+ caracteres aleatorios
# (por ejemplo: openssl rand -base64 48). En desarrollo puede quedar vacío.
AUTH_JWT_SECRET=

# SMS: console (el código aparece en el log), memory (pruebas) o twilio.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Dirección pública del sitio (enlaces de pago). En producción, https.
PUBLIC_WEB_URL=http://localhost:3000

# Cobro de licencias: fake (botones de prueba) o culqi (tarjeta y Yape).
PAYMENTS_PROVIDER=fake
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Va al final de la dirección del webhook en CulqiPanel: …/api/v1/payments/culqi/webhook/<secreto>
CULQI_WEBHOOK_SECRET=

# Comprobante de cada pago de licencia (factura al RUC de la empresa):
# test (PDF de prueba) o nubefact (obligatorio en producción, con la RUTA y el
# TOKEN de la cuenta de Nubefact de quien vende Contabili).
RECEIPTS_PROVIDER=test
RECEIPTS_NUBEFACT_URL=
RECEIPTS_NUBEFACT_TOKEN=
RECEIPTS_SERIES=F001

# Quien vende Contabili (sitio y términos). Obligatorios en producción.
COMPANY_LEGAL_NAME=
COMPANY_RUC=
SUPPORT_EMAIL=

# Descargas de /descargas (https). Solo aparecen las configuradas.
DESKTOP_VERSION=
DOWNLOAD_WINDOWS_URL=
DOWNLOAD_MACOS_URL=
DOWNLOAD_LINUX_URL=
APP_ANDROID_URL=
APP_IOS_URL=
